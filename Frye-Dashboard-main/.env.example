# Frontend environment template
# Copy to .env.local for local development. Never commit .env.local.

# Public backend base URL. Do not include a trailing slash.
REACT_APP_API_BASE=http://localhost:8080
REACT_APP_API_BASE_URL=http://localhost:8080
REACT_APP_API_URL=http://localhost:8080

# Streaming endpoint, if enabled by the backend.
REACT_APP_STREAM_BASE=http://localhost:8080
VITE_API_BASE=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080
VITE_STREAM_BASE=http://localhost:8080

# Keep mock mode enabled until the backend URL and response contracts are verified.
REACT_APP_USE_MOCK=1
VITE_USE_MOCK=1
