# Backend environment template
# Copy to .env for local development or add these names to your chosen backend host secrets.
# Never commit real values, broker tokens or API keys.

NODE_ENV=development
PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:4173

# Market data
POLYGON_API_KEY=
POLYGON_API=
POLY_API_KEY=
POLY_KEY=
POLYGON_REST_BASE=https://api.polygon.io
POLYGON_BASE_URL=https://api.polygon.io
POLY_FUTURES_WS_URL=wss://socket.polygon.io/futures
POLYGON_FUTURES_WS_URL=wss://socket.polygon.io/futures
FUTURES_RESOLVE_CACHE_MS=120000

# Engine 25 and macro/news providers
FMP_API_KEY=
FINNHUB_API_KEY=
FINLIGHT_API_KEY=
FRED_API_KEY=
ENGINE25_FINLIGHT_STREAM_ENABLED=0

# AI narration
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_SPEND_USD=

# GitHub snapshot publishing and raw data reads
GITHUB_TOKEN=
GITHUB_REPO=bfrye1973/frye-market-backend
RAW_OWNER=bfrye1973
RAW_REPO=frye-market-backend
RAW_BRANCH=main
RAW_PATH_INTRADAY=data-live-10min/data/outlook_intraday.json
RAW_PATH_HOURLY=data-live-hourly/data/outlook_hourly.json
RAW_PATH_EOD=data-live-eod/data/outlook.json
RAW_PATH_INTRADAY_DELTA=data-live-10min-sandbox/data/outlook_intraday.json

# Polling and live snapshot source
POLL_MS=30000
SSE_PING_MS=15000
LIVE_URL=
BACKEND1_BASE=
HIST_BASE=
CORE_BASE_URL=
RENDER_EXTERNAL_URL=

# Schwab broker integration — leave empty until owner-approved paper/live setup
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=
SCHWAB_TOKEN_PATH=
SCHWAB_ACCOUNT_IDS=
SCHWAB_TRADING_MODE=paper
SCHWAB_LIVE_ENABLED=0
ENGINE8_PAPER_ONLY=1

# Alerts
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
PUSHOVER_API_TOKEN=
PUSHOVER_DEVICE=

# Storage and safety
TRADE_JOURNAL_DIR=./services/core/data
ENGINE8_PAPER_DATA_DIR=./services/core/data/engine8-paper
ENGINE_CRON_TOKEN=
REPLAY_KEEP_DAYS=30
ENGINE5B_GO_HOLD_MS=120000
ENGINE5B_NEGOTIATED_MAX_DIST_PTS=3.0

